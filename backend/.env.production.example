# =============================================================================
# Variables de PRODUCCIÓN (despliegue de prueba) — referencia, NO un .env real
# =============================================================================
# Estas variables se cargan en Render → nexus-api → Environment. Este archivo
# sólo documenta cuáles son y de dónde sale cada valor; los valores reales
# nunca se commitean. Guía: docs/deployment/despliegue_prueba.md
#
# Las que no aparecen aquí conservan el valor por defecto de
# app/core/config/settings.py.

ENVIRONMENT=production
PYTHON_VERSION=3.12.10

# ── Base de datos (Supabase) ─────────────────────────────────────────────────
# Supabase → Connect → "Session pooler". Cambia el usuario `postgres.<ref>`
# por `nexus_app.<ref>`, pon la contraseña de nexus_app y antepone el driver
# `+asyncpg`. Puerto 5432 (modo sesión), NUNCA 6543.
DATABASE_URL=postgresql+asyncpg://nexus_app.<ref>:<contraseña>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Secretos de firma (Render los genera con generateValue) ──────────────────
# Si los cargas a mano: python -c "import secrets; print(secrets.token_hex(32))"
# Cambiar SECRET_KEY cierra la sesión de todos los usuarios.
SECRET_KEY=
PLATFORM_JWT_SECRET=
PLATFORM_TOTP_KEY=

# ── Fotos (Supabase Storage) ─────────────────────────────────────────────────
STORAGE_BACKEND=supabase
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://<ref>.supabase.co
# Supabase → Project Settings → API Keys → secret key (sb_secret_...) o la
# heredada service_role. SÓLO en el servidor: nunca en la app ni en el repo.
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── CORS: orígenes web, separados por coma, sin "/" final ────────────────────
ALLOWED_ORIGINS=https://nexus-tienda.onrender.com

# ── Correo (Brevo) ───────────────────────────────────────────────────────────
# app.brevo.com → SMTP & API → API Keys. EMAIL_FROM_ADDRESS debe estar
# verificado en Brevo → Senders.
EMAIL_BACKEND=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
