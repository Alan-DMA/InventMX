DATABASE_URL=postgresql+asyncpg://nexus_app:Admin@localhost:5432/nexus
SECRET_KEY=change_this_secret_key_in_production_generate_random_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PROJECT_NAME="Nexus MX API"
API_V1_STR="/api/v1"
ENVIRONMENT=development

# SaaS (Tarea 14.2) — datos bancarios de Nexus y puerta de fundadores
NEXUS_SPEI_CLABE=000000000000000000
NEXUS_SPEI_BANK="Banco por definir"
NEXUS_SPEI_HOLDER="Nexus"
NEXUS_FOUNDER_EMAILS=alandavidma@gmail.com,eduardocristancho05@gmail.com

# Webhooks de pago SaaS (Panel de plataforma, Fase 0): secreto HMAC-SHA256 que
# comparte cada pasarela; firma el cuerpo en el header X-Nexus-Signature.
# Vacío = el webhook rechaza todo (falla cerrado).
SPEI_WEBHOOK_SECRET=
OXXO_WEBHOOK_SECRET=

# Panel de plataforma (Fase 1). Obligatorias en producción: llave de firma de
# los tokens del panel (distinta de SECRET_KEY) y llave que cifra el secreto
# TOTP en la base. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_JWT_SECRET=
PLATFORM_TOTP_KEY=

# Correo saliente (Centro de soporte). "console" = sólo log (desarrollo; en
# producción se niega a enviar). "brevo" = API transaccional de Brevo: crear la
# llave en app.brevo.com → SMTP & API, y verificar EMAIL_FROM_ADDRESS como remitente.
EMAIL_BACKEND=console
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=soporte@nexus.mx
EMAIL_FROM_NAME="Soporte Nexus"

# Fotos de productos: "local" = disco (backend/uploads). "supabase" sólo en el
# despliegue (ver .env.production.example y docs/deployment/despliegue_prueba.md).
STORAGE_BACKEND=local
