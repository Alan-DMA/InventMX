# Lo que NO se envía a Docker al construir la imagen (el "contexto de build").
# Sin este archivo, `COPY . .` metería todo lo de backend/ en la imagen.

# Entorno virtual de Windows: no sirve en Linux y pesa cientos de MB
.venv/

# Secretos: la configuración llega por variables de entorno, nunca horneada
.env
.env.*

# Fotos locales de desarrollo y logs
uploads/
*.log

# Tests y cachés: no se ejecutan en producción
tests/
app/tests/
.pytest_cache/
__pycache__/
*.py[cod]
